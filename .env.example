# ==============================================================================
# Enterprise Hybrid Data Pipeline - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust values for your environment.

# ------------------------------------------------------------------------------
# MongoDB Connection
# ------------------------------------------------------------------------------
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DATABASE=midterm_pipeline
PIPELINE_MONGO_TIMEOUT_MS=5000

# Collection Names
MONGO_RAW_COLLECTION=orders_raw
MONGO_VALIDATED_COLLECTION=orders_validated
MONGO_QUARANTINE_COLLECTION=orders_quarantine

# ------------------------------------------------------------------------------
# Pipeline Router & Ingestion Thresholds
# ------------------------------------------------------------------------------
# Threshold in Megabytes (MB). Files <= threshold use Python Batch Streaming,
# files > threshold use PySpark Distributed Processing.
SMALL_FILE_THRESHOLD_MB=200

# Input files
PIPELINE_INPUT_FILE=data/orders_small_sample.csv
PIPELINE_SAMPLE_FILE=data/orders_small_sample.csv
PIPELINE_HUGE_FILE=data/orders_huge_mixed_quality.csv
PIPELINE_SAMPLE_ROWS=100000

# Python Batch Loader batch size
PIPELINE_BATCH_SIZE=2000
PIPELINE_MONGO_WRITE_BATCH_SIZE=1000

# ------------------------------------------------------------------------------
# Apache Spark Configuration
# ------------------------------------------------------------------------------
# Master URL: local[*] for single-node development, or spark://<master_ip>:7077 for Path A Standalone Cluster
PIPELINE_SPARK_MASTER=local[*]
PIPELINE_SPARK_APP_NAME=MidtermDataPipeline
PIPELINE_SPARK_LOG_LEVEL=WARN
PIPELINE_SPARK_PARTITIONS=16

# Driver & Executor Memory allocation
PIPELINE_SPARK_DRIVER_MEMORY=6g
PIPELINE_SPARK_EXECUTOR_MEMORY=6g
PIPELINE_SPARK_EXECUTOR_CORES=8

# Hardware Acceleration & Flags
PIPELINE_ENABLE_GPU=true
PIPELINE_RUN_ELT_AFTER_RAW=true
PIPELINE_ALLOW_FULL_LOCAL_ELT=true
PIPELINE_LOCAL_ELT_MAX_MB=2048

# ------------------------------------------------------------------------------
# FastAPI & Scheduler Configuration (Phase 2)
# ------------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false
